# =============================================================================
# Web Scraper System - Production Configuration
# Copy this file to .env and adjust values as needed
# =============================================================================

# -----------------------------------------------------------------------------
# Redis Configuration (Required)
# -----------------------------------------------------------------------------
# Redis connection URL for Celery broker/result backend and deduplication
# Format: redis://[:password]@host:port/db
# In Docker Compose, use the service name 'redis' as hostname
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Proxy Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of proxies (format: user:pass@host:port)
# Alternatively, use PROXY_LIST_PATH to load from a file
# PROXY_LIST=user:pass@host1:port,user:pass@host2:port

# Path to proxy list file (one proxy per line)
# File format: user:pass@host:port (or host:port for no auth)
# Relative to container working directory (/app)
PROXY_LIST_PATH=proxyscrape_premium_http_proxies.txt

# Enable/disable proxy usage entirely
PROXY_ENABLED=true

# Run connectivity check against httpbin.org on startup and periodically
# If false, trusts proxies until actual target failures occur
PROXY_HEALTH_CHECK=true

# Periodic health re-check interval in seconds (default: 3600 = 1 hour)
PROXY_HEALTH_CHECK_INTERVAL=3600

# Allow direct connection fallback when all proxies cooling down
PROXY_FALLBACK_DIRECT=true

# Cooldown period in seconds after a proxy failure (default: 300)
PROXY_COOLDOWN_SECONDS=300

# Max consecutive target failures before permanently disabling a proxy (default: 3)
PROXY_MAX_CONSECUTIVE_FAILURES=3

# Maximum proxy attempts per URL before giving up (default: 3)
MAX_PROXY_ATTEMPTS_PER_URL=3

# -----------------------------------------------------------------------------
# Captcha Solver (Optional - only needed for interactive CAPTCHA challenges)
# -----------------------------------------------------------------------------
# Supported providers: 2captcha, anticaptcha, capmonster
# CAPTCHA_SOLVER_PROVIDER=2captcha
# CAPTCHA_SOLVER_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Concurrency & Pacing
# -----------------------------------------------------------------------------
# Maximum concurrent browser contexts per worker
MAX_CONCURRENT_BROWSERS=5

# Concurrency for CSV processing (number of parallel company scrapes)
CSV_PROCESSING_CONCURRENCY=3

# Delay between requests (seconds) - random uniform between min and max
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=4.0

# -----------------------------------------------------------------------------
# Request Timeouts (seconds)
# -----------------------------------------------------------------------------
# Page load timeout
PAGE_LOAD_TIMEOUT=30

# Selector wait timeout
SELECTOR_WAIT_TIMEOUT=20

# Navigation timeout
NAVIGATION_TIMEOUT=30

# -----------------------------------------------------------------------------
# Retry Configuration
# -----------------------------------------------------------------------------
# Maximum retry attempts for failed operations
MAX_RETRIES=3

# Base delay for exponential backoff (seconds)
RETRY_BASE_DELAY=2.0

# Maximum delay for retries (seconds)
RETRY_MAX_DELAY=60.0

# -----------------------------------------------------------------------------
# Priority CSV Processing
# -----------------------------------------------------------------------------
# Comma-separated list of CSV filenames (without .csv) to process first
# Example: "delhi,ROC-ANDHRA" processes delhi.csv first, then ROC-ANDHRA.csv
PRIORITY_CSV_FILES=delhi

# Maximum consecutive failures on priority file before falling back to others
PRIORITY_FALLBACK_THRESHOLD=5

# How often to check if priority file is available again (seconds)
PRIORITY_RECHECK_INTERVAL=60

# -----------------------------------------------------------------------------
# Output & Logging
# -----------------------------------------------------------------------------
# Output directory for scraped data (JSONL, CSV)
OUTPUT_DIR=./data

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Checkpointing (for crash recovery / resume)
# -----------------------------------------------------------------------------
# Directory for checkpoint files
CHECKPOINT_DIR=./data/checkpoints

# Save checkpoint every N companies processed
CHECKPOINT_INTERVAL=100

# -----------------------------------------------------------------------------
# Test Mode
# -----------------------------------------------------------------------------
# Limit total companies to scrape (0 = unlimited, set to 10 for quick testing)
TEST_LIMIT=0

# -----------------------------------------------------------------------------
# Graceful Shutdown
# -----------------------------------------------------------------------------
# Maximum seconds to wait for in-flight operations during shutdown
SHUTDOWN_TIMEOUT=30
# --- S3 upload (scraped output backup) ---
# Enable and point at your bucket. Credentials come from the EC2 IAM role in
# prod, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars locally.
S3_ENABLED=false
S3_BUCKET=kahemindia
S3_PREFIX=scraper
AWS_REGION=ap-south-1
S3_SYNC_INTERVAL_MINUTES=5
