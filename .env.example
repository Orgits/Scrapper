# Redis - broker + result backend for Celery, also used for dedup set
REDIS_URL=redis://redis:6379/0

# --- Proxies: use ONE of the two options below ---
# Option A: static list of proxies you manage yourself
PROXY_LIST=http://user1:pass1@proxy1.example.com:8000,http://user2:pass2@proxy2.example.com:8000

# Option B: a rotating-proxy provider that hands out a fresh IP per request
# (Bright Data, Oxylabs, Smartproxy, IPRoyal, etc). Leave PROXY_LIST empty if using this.
PROXY_PROVIDER_API_URL=https://api.proxyscrape.com
PROXY_PROVIDER_API_KEY=phFsERIj9vFQqCpJ0JLLTPK1VFDCcVs7mSgFrEKFyFj3vbFXwg6c0e6cdSVvKswi

# Optional: only needed if a target site serves interactive CAPTCHA challenges
# (2Captcha / Anti-Captcha / CapMonster all expose a similar submit+poll API)
CAPTCHA_SOLVER_PROVIDER=2captcha
CAPTCHA_SOLVER_API_KEY=

# Concurrency / pacing
MAX_CONCURRENT_BROWSERS=5
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=4.0

# Output
OUTPUT_DIR=./data
LOG_LEVEL=INFO
